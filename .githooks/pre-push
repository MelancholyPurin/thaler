#!/bin/sh
# Runs the lint and the go.mod check before a push, so that a push does not wait for
# CI to say what `make lint` says in a minute. `make hooks` turns it on; `git push
# --no-verify` skips it once.
#
# It checks the working tree, not the commits being pushed: a change not yet committed
# is checked too. A push that only deletes branches has nothing to check.
zero=0000000000000000000000000000000000000000
pushes=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	[ "$local_sha" = "$zero" ] || pushes=1
done
[ "$pushes" = 1 ] || exit 0

if ! ${MAKE:-make} lint tidy-check; then
	echo "pre-push: the lint failed, so nothing was pushed (git push --no-verify skips this check)" >&2
	exit 1
fi
